{% block fastmon_collector_collection %}
<div class="fastmon-collector-collection">

    <p v-if="isLoading" class="fastmon-collector-collection__note">
        {{ $tc('fastmon-collector.loading') }}
    </p>

    <p v-else-if="!provisioned" class="fastmon-collector-collection__note">
        {{ $tc('fastmon-collector.collection.needsApplication') }}
    </p>

    <template v-else>
        <p v-if="error" class="fastmon-collector-collection__note is--error">{{ error }}</p>

        <p class="fastmon-collector-collection__hint">
            {{ $tc('fastmon-collector.collection.intro') }}
            <a href="https://docs.fastmon.eu/first-party"
               target="_blank"
               rel="noopener noreferrer">{{ $tc('fastmon-collector.collection.docs') }}</a>
        </p>

        <label class="fastmon-collector-collection__option">
            <input type="radio" :value="modes.DEFAULT" v-model="selectedMode" @change="onModeChange">
            <span>
                <strong>{{ $tc('fastmon-collector.collection.modeDefault') }}</strong>
                <span class="fastmon-collector-collection__meta">
                    {{ $tc('fastmon-collector.collection.modeDefaultHint') }}
                </span>
            </span>
        </label>

        <label class="fastmon-collector-collection__option">
            <input type="radio" :value="modes.CUSTOM" v-model="selectedMode" @change="onModeChange">
            <span>
                <strong>{{ $tc('fastmon-collector.collection.modeCustom') }}</strong>
                <span class="fastmon-collector-collection__meta">
                    {{ $tc('fastmon-collector.collection.modeCustomHint') }}
                </span>
            </span>
        </label>

        <input v-if="selectedMode === modes.CUSTOM"
               v-model="customDomain"
               type="text"
               class="fastmon-collector-collection__input"
               placeholder="https://metrics.example.com"
               @input="onModeChange">

        <label class="fastmon-collector-collection__option">
            <input type="radio" :value="modes.RELATIVE" v-model="selectedMode" @change="onModeChange">
            <span>
                <strong>{{ $tc('fastmon-collector.collection.modeRelative') }}</strong>
                <span class="fastmon-collector-collection__meta">
                    {{ $tc('fastmon-collector.collection.modeRelativeHint') }}
                </span>
            </span>
        </label>

        <!-- Shown up front, because relative needs EVERY one of these configured and
             finding that out after a failed check is the worse order. -->
        <p v-if="selectedMode === modes.RELATIVE && storefrontOrigins.length"
           class="fastmon-collector-collection__meta">
            {{ $tc('fastmon-collector.collection.origins') }}
            {{ storefrontOrigins.join(', ') }}
        </p>

        <div class="fastmon-collector-collection__actions">
            <button v-if="needsProof"
                    type="button"
                    class="fastmon-collector-collection__button"
                    :disabled="isBusy || isChecking || !canCheck"
                    @click="check">
                {{ isChecking
                    ? $tc('fastmon-collector.collection.checking')
                    : $tc('fastmon-collector.collection.check') }}
            </button>

            <button type="button"
                    class="fastmon-collector-collection__button is--primary"
                    :disabled="isBusy || !canApply"
                    @click="apply">
                {{ $tc('fastmon-collector.collection.apply') }}
            </button>
        </div>

        <ul v-if="checkedThisMode" class="fastmon-collector-collection__list">
            <li v-for="domain in checkedDomains"
                :key="domain.domain"
                class="fastmon-collector-collection__result">
                <span class="fastmon-collector-collection__resultHead">
                    <strong>{{ domain.domain }}</strong>
                    <span :class="domain.ready ? 'is--ok' : 'is--error'">
                        {{ domain.ready
                            ? $tc('fastmon-collector.collection.domainOk')
                            : $tc('fastmon-collector.collection.domainFailed') }}
                    </span>
                </span>
                <!-- What was found and what it means, rather than a status code on its
                     own: 404 and 502 need different fixes, and neither says so. -->
                <span v-if="!domain.ready" class="fastmon-collector-collection__meta">
                    {{ reasonText(domain) }}
                </span>
            </li>
        </ul>

        <p v-if="checkedThisMode && !checkedDomains.length" class="fastmon-collector-collection__note is--error">
            {{ $tc('fastmon-collector.collection.nothingChecked') }}
        </p>

        <!-- Said once, at the end: which mode stays out of reach, and what to do next. -->
        <p v-else-if="checkedThisMode && !status.ready" class="fastmon-collector-collection__note">
            {{ $tc('fastmon-collector.collection.blocked', 0, { mode: selectedModeLabel }) }}
            <a href="https://docs.fastmon.eu/first-party"
               target="_blank"
               rel="noopener noreferrer">{{ $tc('fastmon-collector.collection.docs') }}</a>
        </p>

        <p v-else-if="checkedThisMode" class="fastmon-collector-collection__note is--ok">
            {{ $tc('fastmon-collector.collection.allReady', 0, { mode: selectedModeLabel }) }}
        </p>

        <template v-if="needsProof">
            <!-- Without the secret fastmon cannot trust the visitor IP the proxy
                 forwards, and every visitor ends up on the shop server's location. -->
            <p class="fastmon-collector-collection__hint">
                {{ $tc('fastmon-collector.collection.secretHint') }}
            </p>
            <div v-if="proxySecret" class="fastmon-collector-collection__secret">{{ proxySecret }}</div>
            <button type="button"
                    class="fastmon-collector-collection__button"
                    :disabled="isBusy"
                    @click="generateProxySecret">
                {{ $tc('fastmon-collector.collection.secret') }}
            </button>
        </template>
    </template>
</div>
{% endblock %}
