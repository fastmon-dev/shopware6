{% block fastmon_collector_collection %}
<div class="fastmon-collector-collection">
    <mt-loader v-if="isLoading" size="32px" />

    <mt-banner v-else-if="!provisioned" variant="info">
        {{ $t('fastmon-collector.collection.needsApplication') }}
    </mt-banner>

    <template v-else>
        <mt-banner v-if="error" :variant="errorVariant">
            {{ error }}
        </mt-banner>

        <p class="fastmon-collector-collection__hint">
            {{ $t('fastmon-collector.collection.intro') }}
            <a
                class="fastmon-collector-collection__link"
                :href="$t('fastmon-collector.collection.docsUrl')"
                target="_blank"
                rel="noopener noreferrer"
            >
                {{ $t('fastmon-collector.collection.docs') }}
            </a>
        </p>

        <sw-radio-field
            :value="selectedMode"
            :options="modeOptions"
            :disabled="isBusy || isChecking"
            @update:value="onModeChange"
        />

        <mt-text-field
            v-if="selectedMode === modes.CUSTOM"
            :model-value="customDomain"
            name="fastmon-custom-domain"
            :label="$t('fastmon-collector.collection.modeCustom')"
            placeholder="https://metrics.example.com"
            :disabled="isBusy || isChecking"
            @update:model-value="onCustomDomainInput"
        />

        {# Shown up front, because relative needs EVERY one of these configured and
           finding that out after a failed check is the worse order. #}
        <p
            v-if="selectedMode === modes.RELATIVE && storefrontOrigins.length"
            class="fastmon-collector-collection__meta"
        >
            {{ $t('fastmon-collector.collection.origins') }}
            {{ storefrontOrigins.join(', ') }}
        </p>

        <div class="fastmon-collector-collection__actions">
            <mt-button
                v-if="needsProof"
                variant="secondary"
                :disabled="isBusy || isChecking || !canCheck"
                :is-loading="isChecking"
                @click="check"
            >
                {{ $t('fastmon-collector.collection.check') }}
            </mt-button>

            <mt-button
                variant="primary"
                :disabled="isBusy || !canApply"
                :is-loading="isBusy"
                @click="apply"
            >
                {{ $t('fastmon-collector.collection.apply') }}
            </mt-button>
        </div>

        <ul v-if="checkedThisMode" class="fastmon-collector-collection__list">
            <li
                v-for="domain in checkedDomains"
                :key="domain.domain"
                class="fastmon-collector-collection__result"
            >
                <span class="fastmon-collector-collection__resultHead">
                    <strong>{{ domain.domain }}</strong>
                    <span :class="domain.ready ? 'is--ok' : 'is--error'">
                        {{ domain.ready
                            ? $t('fastmon-collector.collection.domainOk')
                            : $t('fastmon-collector.collection.domainFailed') }}
                    </span>
                </span>
                {# What was found and what it means, rather than a status code on its
                   own: 404 and 502 need different fixes, and neither says so. #}
                <span v-if="!domain.ready" class="fastmon-collector-collection__meta">
                    {{ reasonText(domain) }}
                </span>
            </li>
        </ul>

        <mt-banner v-if="checkedThisMode && !checkedDomains.length" variant="critical">
            {{ $t('fastmon-collector.collection.nothingChecked') }}
        </mt-banner>

        {# Said once, at the end: which mode stays out of reach, and what to do next. #}
        <mt-banner v-else-if="checkedThisMode && !status.ready" variant="attention">
            {{ $t('fastmon-collector.collection.blocked', { mode: selectedModeLabel }) }}
            <a
                class="fastmon-collector-collection__link"
                :href="$t('fastmon-collector.collection.docsUrl')"
                target="_blank"
                rel="noopener noreferrer"
            >
                {{ $t('fastmon-collector.collection.docs') }}
            </a>
        </mt-banner>

        <mt-banner v-else-if="checkedThisMode" variant="positive">
            {{ $t('fastmon-collector.collection.allReady', { mode: selectedModeLabel }) }}
        </mt-banner>

        <template v-if="needsProof">
            {# Without the secret fastmon cannot trust the visitor IP the proxy forwards,
               and every visitor ends up on the shop server's location. #}
            <p class="fastmon-collector-collection__hint">
                {{ $t('fastmon-collector.collection.secretHint') }}
            </p>

            <div v-if="proxySecret" class="fastmon-collector-collection__secret">{{ proxySecret }}</div>

            <mt-button
                variant="secondary"
                :disabled="isBusy"
                @click="generateProxySecret"
            >
                {{ $t('fastmon-collector.collection.secret') }}
            </mt-button>
        </template>
    </template>
</div>
{% endblock %}
