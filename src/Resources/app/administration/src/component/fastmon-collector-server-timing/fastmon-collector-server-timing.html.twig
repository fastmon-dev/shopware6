{% block fastmon_collector_server_timing %}
<div class="fastmon-collector-server-timing">
    <div class="fastmon-collector-server-timing__header">
        <span class="fastmon-collector-server-timing__title">
            {{ $t('fastmon-collector.serverTiming.title') }}
        </span>

        <mt-button
            variant="secondary"
            size="x-small"
            :disabled="isLoading"
            :is-loading="isLoading"
            @click="load"
        >
            {{ $t('fastmon-collector.serverTiming.reload') }}
        </mt-button>
    </div>

    <p class="fastmon-collector-server-timing__lead">
        {{ $t('fastmon-collector.serverTiming.lead') }}
    </p>

    <mt-loader v-if="isLoading" size="32px" />

    <mt-banner v-else-if="error" variant="critical">
        {{ error }}
    </mt-banner>

    <template v-else>
        {# Every known source with what it is doing. One being absent is not a fault; not
           knowing which one is measuring is. #}
        <ul class="fastmon-collector-server-timing__sources">
            <li
                v-for="src in sources"
                :key="src.name"
                class="fastmon-collector-server-timing__item"
            >
                <span class="fastmon-collector-server-timing__name">
                    {{ sourceName(src) }}
                </span>
                <span
                    class="fastmon-collector-server-timing__state"
                    :class="`is--${src.state}`"
                >
                    {{ sourceState(src) }}
                </span>
            </li>
        </ul>

        <mt-banner v-if="!isAvailable" variant="attention">
            {{ $t('fastmon-collector.serverTiming.sourceMissing') }}
        </mt-banner>
    </template>
</div>
{% endblock %}
