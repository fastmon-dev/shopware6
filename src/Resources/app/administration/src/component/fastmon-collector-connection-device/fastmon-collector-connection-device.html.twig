{% block fastmon_collector_connection_device %}
<div class="fastmon-collector-connection-device">
    <p class="fastmon-collector-connection__hint">
        {{ $tc('fastmon-collector.connect.intro') }}
    </p>

    {# Device authorization in flight: the merchant approves in their own browser while
       the shop polls. #}
    <div v-if="device" class="fastmon-collector-connection__section">
        <p class="fastmon-collector-connection__hint">
            {{ $tc('fastmon-collector.connect.deviceIntro') }}
        </p>

        <div class="fastmon-collector-connection__code">{{ device.userCode }}</div>

        <p>
            <mt-link
                as="a"
                type="external"
                :href="device.verificationUriComplete"
                target="_blank"
                rel="noopener noreferrer"
            >
                {{ $tc('fastmon-collector.connect.openFastmon') }}
            </mt-link>
        </p>

        <p class="fastmon-collector-connection__hint">
            {{ $tc('fastmon-collector.connect.waiting') }}
        </p>

        <mt-button variant="secondary" @click="cancelDevice">
            {{ $tc('fastmon-collector.connect.cancel') }}
        </mt-button>
    </div>

    <mt-button
        v-else-if="!deviceUnsupported"
        variant="primary"
        :disabled="isBusy"
        :is-loading="isBusy"
        @click="connect"
    >
        {{ $tc('fastmon-collector.connect.start') }}
    </mt-button>

    {# Only shown once fastmon has said it cannot do the guided flow, so the good path
       is never competing with a field asking for a secret. #}
    <div v-if="deviceUnsupported" class="fastmon-collector-connection__section">
        <mt-banner variant="info">
            {{ $tc('fastmon-collector.connect.unsupported') }}
        </mt-banner>

        <mt-password-field
            v-model="token"
            name="fastmon-token"
            :label="$tc('fastmon-collector.connect.tokenLabel')"
            :help-text="$tc('fastmon-collector.connect.tokenScopes')"
            placeholder="fm_..."
        />

        <mt-button
            variant="primary"
            :disabled="isBusy || !token"
            :is-loading="isBusy"
            @click="connectWithToken"
        >
            {{ $tc('fastmon-collector.connect.saveToken') }}
        </mt-button>
    </div>
</div>
{% endblock %}
