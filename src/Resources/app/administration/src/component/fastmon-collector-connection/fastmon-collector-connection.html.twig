{% block fastmon_collector_connection %}
<div class="fastmon-collector-connection">
    <mt-loader v-if="isLoading" size="32px" />

    <template v-else>
        {# A pending org review is a waiting state, not a fault, so it is not styled as
           one - the merchant has nothing to fix and nothing to retry. #}
        <mt-banner
            v-if="error"
            :variant="errorVariant"
            class="fastmon-collector-connection__banner"
        >
            <template v-if="pendingApproval">
                {{ $tc('fastmon-collector.provision.pendingApproval') }}
            </template>
            <template v-else>
                {{ error }}
                <template v-if="missingPermission">
                    {{ $tc('fastmon-collector.connect.missingPermission', 0, { permission: missingPermission }) }}
                </template>
            </template>
        </mt-banner>

        {# ---------- not connected ---------- #}
        <fastmon-collector-connection-device
            v-if="!isConnected"
            @connected="onConnected"
            @error="applyFastmonError"
        />

        {# ---------- connected ---------- #}
        <template v-else>
            <p class="fastmon-collector-connection__account">
                {{ $tc('fastmon-collector.connectedAs') }}
                <strong>{{ connectedAs }}</strong>
                <template v-if="organizationLabel">
                    &middot; {{ $tc('fastmon-collector.provision.organization') }}
                    <strong>{{ organizationLabel }}</strong>
                </template>
            </p>

            <mt-banner v-if="needsReconnect" variant="critical">
                {{ $tc('fastmon-collector.connect.rejected') }}
            </mt-banner>

            {# Connected, but no usable application: the token is good, so this is a
               choice to make rather than a disconnect. #}
            <fastmon-collector-connection-provisioning
                v-else-if="!isProvisioned || needsRelink"
                :status="status"
                @linked="onLinked"
                @error="applyFastmonError"
            />

            {# Connected and linked. The domains fastmon has actually seen are the honest
               answer to "is it collecting?" in a way an id and a checkmark are not. #}
            <template v-else>
                <p class="fastmon-collector-connection__label">
                    {{ $tc('fastmon-collector.summary.sites') }}
                </p>

                <ul v-if="sites.length" class="fastmon-collector-connection__list">
                    <li
                        v-for="site in sites"
                        :key="site.id"
                        class="fastmon-collector-connection__item"
                    >
                        <strong>{{ site.domain }}</strong>
                    </li>
                </ul>

                <p v-else class="fastmon-collector-connection__hint">
                    {{ $tc('fastmon-collector.summary.noSites') }}
                </p>

                {# Ids belong here and not on the surface: nobody acts on them, and
                   support asks for them roughly once a year. #}
                <details class="fastmon-collector-connection__debug">
                    <summary>{{ $tc('fastmon-collector.summary.debug') }}</summary>
                    <dl class="fastmon-collector-connection__summary">
                        <dt>{{ $tc('fastmon-collector.summary.application') }}</dt>
                        <dd><code>{{ status.applicationId }}</code></dd>
                        <dt>{{ $tc('fastmon-collector.summary.trackerId') }}</dt>
                        <dd><code>{{ status.trackerId }}</code></dd>
                        <dt>{{ $tc('fastmon-collector.summary.pixelId') }}</dt>
                        <dd><code>{{ status.pixelId || '-' }}</code></dd>
                    </dl>
                </details>
            </template>

            <div class="fastmon-collector-connection__actions">
                <mt-button
                    v-if="isLinked"
                    variant="secondary"
                    :disabled="isBusy"
                    @click="refreshApplication"
                >
                    {{ $tc('fastmon-collector.summary.refresh') }}
                </mt-button>

                <mt-button
                    variant="critical"
                    :disabled="isBusy"
                    @click="disconnect"
                >
                    {{ $tc('fastmon-collector.disconnect') }}
                </mt-button>
            </div>

            <p class="fastmon-collector-connection__hint">
                {{ $tc('fastmon-collector.disconnectHint') }}
            </p>
        </template>
    </template>
</div>
{% endblock %}
